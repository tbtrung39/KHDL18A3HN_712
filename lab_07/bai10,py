m = input("Nhập số tự nhiên thứ nhất: ")
n = input("Nhập số tự nhiên thứ hai: ")
chua_so_n1 = set(m)
chua_so_n2 = set(n)
chung = chua_so_n1 & chua_so_n2
tong = sum(int(chu_so) for chu_so in chung)
print(f"Các chữ số chung của {m} và {n} là: {', '.join(chung)}")
print(f"Tổng các chữ số chung của {m} và {n} là: {tong}")